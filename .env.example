# Copy into .env.local and set real values. Never commit .env.local.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=GENERATE_A_LONG_RANDOM_VALUE
# Optional for regular user Google OAuth. Both required if enabled.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Emergency all-ads-off server switch (no database changes required).
ADS_EMERGENCY_OFF=false
# Only needed when running npm run admin:bootstrap:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
